class Q24 {
    public static void main(String[] args) {

        int[] a = {10, 20, 10, 30, 20, 40};
        int[] b = new int[a.length];

        int n = 0;

        for (int i = 0; i < a.length; i++) {

            boolean duplicate = false;

            for (int j = 0; j < n; j++) {
                if (a[i] == b[j]) {
                    duplicate = true;
                    break;
                }
            }

            if (!duplicate) {
                b[n] = a[i];
                n++;
            }
        }

        System.out.println("Array after removing duplicates:");

        for (int i = 0; i < n; i++) {
            System.out.print(b[i] + " ");
        }
    }
}