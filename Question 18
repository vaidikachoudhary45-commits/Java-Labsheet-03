class Q18 {
    public static void main(String[] args) {

        int[][][] a = {
            {
                {10, 20},
                {30, 40}
            },
            {
                {50, 60},
                {70, 80}
            }
        };

        int search = 60;
        boolean found = false;

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                for (int k = 0; k < 2; k++) {

                    if (a[i][j][k] == search) {
                        System.out.println("Element found at position: ["
                                + i + "][" + j + "][" + k + "]");
                        found = true;
                    }
                }
            }
        }

        if (!found)
            System.out.println("Element not found.");
    }
}